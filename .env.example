# LLM provider: "anthropic" or "openai". Only the chosen provider's key is used.
SPENDSIGHT_LLM_PROVIDER=anthropic
SPENDSIGHT_LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SPENDSIGHT_LOCAL_ONLY=false
# Comma-separated names to mask in anything sent to an LLM, e.g. landlord or family names.
SPENDSIGHT_REDACT_NAMES=
SPENDSIGHT_DB_PATH=data/spendsight.duckdb
SPENDSIGHT_ML_CONF_THRESHOLD=0.75
